{
  "project": {
    "name": "demo",
    "workdir": "./workdir"
  },
  "storage": {
    "backend": "sqlite",
    "database": "./workdir/data.sqlite"
  },
  "parsing": {
    "formats": [
      "pdf",
      "docx"
    ],
    "scan_policy": "report_unsupported",
    "vision_enabled": false,
    "vision": {
      "max_edge": 2048,
      "tile_edge": 1536,
      "tile_overlap": 192,
      "max_tiles": 16,
      "detail": "high",
      "context_blocks": 2,
      "context_chars": 6000,
      "verify": true
    }
  },
  "chunking": {
    "strategy": "structural",
    "target_tokens": 900,
    "overlap_tokens": 100,
    "token_counter": "tiktoken_approx"
  },
  "models": {
    "llm": {
      "adapter": "openai_sdk",
      "api_mode": "chat_completions",
      "response_format": "json_schema",
      "thinking_mode": "default",
      "max_output_tokens": null,
      "base_url": "",
      "model": "",
      "api_key_env": "TC_RAG_LLM_API_KEY",
      "concurrency": 3,
      "batch_size": 16,
      "enabled": true,
      "supports_images": false
    },
    "embedding": {
      "adapter": "openai_sdk",
      "api_mode": "chat_completions",
      "response_format": "json_schema",
      "thinking_mode": "default",
      "max_output_tokens": null,
      "base_url": "",
      "model": "",
      "api_key_env": "TC_RAG_EMBEDDING_API_KEY",
      "concurrency": 2,
      "batch_size": 16,
      "enabled": true,
      "supports_images": false
    },
    "vision": {
      "adapter": "openai_sdk",
      "api_mode": "chat_completions",
      "response_format": "json_schema",
      "thinking_mode": "default",
      "max_output_tokens": null,
      "base_url": "",
      "model": "",
      "api_key_env": "TC_RAG_VISION_API_KEY",
      "concurrency": 3,
      "batch_size": 16,
      "enabled": false,
      "supports_images": false
    },
    "rerank": {
      "adapter": "http",
      "api_mode": "chat_completions",
      "response_format": "json_schema",
      "thinking_mode": "default",
      "max_output_tokens": null,
      "base_url": "",
      "model": "",
      "api_key_env": "TC_RAG_RERANK_API_KEY",
      "concurrency": 3,
      "batch_size": 16,
      "enabled": false,
      "supports_images": false
    }
  },
  "retrieval": {
    "embedding_dimension": 1536,
    "scope": "requirement_set",
    "backend": "numpy",
    "metric": "cosine",
    "normalize": true,
    "vector_top_k": 20,
    "keyword_enabled": false,
    "rerank_top_n": 6,
    "threshold_policy": "disabled"
  },
  "planning": {
    "max_points_per_rule": 12,
    "methods": [
      "equivalence",
      "boundary",
      "decision_table",
      "state",
      "permission"
    ],
    "relation_enabled": false
  },
  "generation": {
    "skill_file": null,
    "max_cases_per_point": 3,
    "batch_point_limit": 5,
    "schema_repair_attempts": 1,
    "unsupported_expectation_policy": "flag"
  },
  "runtime": {
    "max_context_tokens": 12000,
    "max_attempts": 3,
    "request_timeout_seconds": 90.0,
    "vision_min_interval_seconds": 0.0,
    "cache_enabled": true,
    "chunk_failure_policy": "fail",
    "budget": {
      "max_calls": null,
      "max_cost": null
    }
  },
  "observability": {
    "metrics_enabled": true,
    "save_raw_model_payloads": false
  },
  "export": {
    "formats": [
      "json",
      "markdown",
      "xlsx"
    ],
    "include_issues": true,
    "include_coverage": true,
    "case_columns": [],
    "point_tree_layout": "module"
  }
}
