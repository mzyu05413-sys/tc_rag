# Normalize text in Git; keep working copies consistent across platforms.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.pdf binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.npy binary
*.npz binary
