        </mxCell>
        <mxCell id="WORKERS" value="固定工作协程数&#10;min(models.llm.concurrency, 批次数)" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="1095.34" y="224.0" as="geometry" width="348.23" height="74.6" />
        </mxCell>
        <mxCell id="BATCH" value="每批内部按顺序执行&#10;提炼：预算 → LLM&#10;规划 / 生成：预算 → RAG / 重排 → LLM" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="1199.9" y="358.6" as="geometry" width="366" height="92.2" />
        </mxCell>
        <mxCell id="ORDER" value="按输入批次顺序归并&#10;首个致命错误取消并等待其余工人" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="1142.15" y="510.8" as="geometry" width="313" height="74.6" />
        </mxCell>
        <mxCell id="CACHE" value="缓存键：完整请求 + 输出 Schema + 模型配置&#10;命中才复用；父运行缓存仅允许提炼复用" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="2175.97" y="717.4" as="geometry" width="404.45" height="74.6" />
        </mxCell>
        <mxCell id="HTTP" value="生成模型请求&#10;适配器信号量 + 单次 timeout&#10;真实尝试计入共享 max_calls" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="1448.8" y="901.0" as="geometry" width="287.4" height="92.2" />
        </mxCell>
        <mxCell id="SAVE" value="合规输出才写缓存&#10;后续仍核验原文、引用及业务风险" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="2131.02" y="1582.27" as="geometry" width="314" height="74.6" />
        </mxCell>
        <mxCell id="RESULT" value="返回情况" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rhombus;fillColor=#fff7ed;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="1926.31" y="1053.2" as="geometry" width="177" height="177" />
        </mxCell>
        <mxCell id="RETRY" value="runtime.max_attempts 内退避重试&#10;遵守 Retry-After；鉴权等直接失败" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#fff7ed;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="1479.2" y="1381.07" as="geometry" width="329.11" height="74.6" />
        </mxCell>
        <mxCell id="SCHEMA" value="JSON / Schema 校验&#10;同类提炼 ID 唯一&#10;用例 point_ids 仅限当前批次枚举" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="1858.3" y="1375.2" as="geometry" width="312.02" height="92.2" />
        </mxCell>
        <mxCell id="REPAIR" value="generation.schema_repair_attempts 内修复&#10;只发安全字段路径、类型和允许值&#10;调用记录保存诊断，不回放错误正文" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="1233.72" y="1576.4" as="geometry" width="398.03" height="92.2" />
        </mxCell>
        <mxCell id="SPLIT" value="多测试点批次二分后依次执行&#10;直接输入超预算也可二分&#10;单点仍超限则失败" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#fff7ed;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="2220.32" y="1375.2" as="geometry" width="281" height="92.2" />
        </mxCell>
        <mxCell id="VISION" value="Vision：独立图片工人 + 信号量&#10;最小间隔、限流冷却、缓存&#10;单图失败继续；账户阻断停发未缓存图" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1">
          <mxGeometry x="424.22" y="717.4" as="geometry" width="302.12" height="92.2" />
        </mxCell>
        <mxCell id="EMBEDDING" value="Embedding：batch_size + concurrency&#10;按 index 恢复顺序，校验向量空间&#10;空间 / 缓存损坏或检索失败阻断 RAG" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1">
