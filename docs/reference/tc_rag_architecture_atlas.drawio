          <mxGeometry x="386.17" y="94.0" as="geometry" width="285.47" height="74.6" />
        </mxCell>
        <mxCell id="PRE" value="02 配置预检与依赖装配&#10;生成、向量必需；视觉 / 重排按开关" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="364.25" y="208.6" as="geometry" width="329.31" height="74.6" />
        </mxCell>
        <mxCell id="INGEST" value="03 接入文件 · 本地&#10;校验格式 / 大小、指纹、保存原件和 Document" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="321.8" y="323.2" as="geometry" width="414.22" height="74.6" />
        </mxCell>
        <mxCell id="FORMAT" value="PDF 或 DOCX？" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rhombus;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="440.91" y="437.8" as="geometry" width="177" height="177" />
        </mxCell>
        <mxCell id="PDF" value="PdfParser · 本地&#10;文字、表格、图片、页码和坐标&#10;逐页检查点；低文字页记未解析" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="177.97" y="719.8" as="geometry" width="336.48" height="92.2" />
        </mxCell>
        <mxCell id="WORD" value="DocxParser · 本地&#10;段落 / 表格顺序、图片和结构位置" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="554.45" y="728.6" as="geometry" width="314.31" height="74.6" />
        </mxCell>
        <mxCell id="BLOCKS" value="DocumentBlock + 图片 Asset + 解析 Issue" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="334.38" y="852" as="geometry" width="389.06" height="57" />
        </mxCell>
        <mxCell id="VISON" value="启用视觉且有图片？" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rhombus;fillColor=#fff7ed;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="428.41" y="949" as="geometry" width="202" height="202" />
        </mxCell>
        <mxCell id="VLM" value="04 图片解释 · models.vision&#10;缓存 → 限速并发 → 文字解释&#10;失败记待确认；origin=vision，uncertain=true" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="205.9" y="1256.0" as="geometry" width="417.34" height="92.2" />
        </mxCell>
        <mxCell id="CHUNK" value="05 分块 · 本地&#10;保留原始 Block、标题和字符区间" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="373.44" y="1388.2" as="geometry" width="310.94" height="74.6" />
        </mxCell>
        <mxCell id="EXTRACT" value="06 规则提炼 · models.llm&#10;按 Chunk 有界并发 → Extraction&#10;JSON / Schema / 同类 ID 校验与有界修复" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="339.59" y="1502.8" as="geometry" width="378.64" height="92.2" />
        </mxCell>
        <mxCell id="CHECK" value="07 核验与归并 · 本地&#10;逐字引文、Locator、区间、引用闭包&#10;保守合并重复；缺漏和冲突进入 Issue" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="358.77" y="1635.0" as="geometry" width="340.27" height="92.2" />
        </mxCell>
        <mxCell id="INDEX" value="08 准备需求检索索引 · models.embedding&#10;有效证据 + Chunk 原文区间&#10;缓存 / 批量向量化 → NumPy 或 FAISS →&#10;校验发布" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1">
          <mxGeometry x="336.4" y="1767.2" as="geometry" width="385.02" height="109.8" />
        </mxCell>
        <mxCell id="BASE" value="09 基础测试点 · 本地规则&#10;明确整数上限 300 → 299 / 300 / 301&#10;缺精度 / 条件则保留待澄清" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="357.18" y="1917.0" as="geometry" width="343.45" height="92.2" />
        </mxCell>
        <mxCell id="PLAN" value="10 第一轮 RAG 规划 · models.llm&#10;规则批次检索 → 可选 models.rerank&#10;直接证据 + 补充资料 → 补充测试意图" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="357.5" y="2049.2" as="geometry" width="342.81" height="92.2" />
        </mxCell>
        <mxCell id="POINTS" value="11 核验并保存全部测试点与 PointTree&#10;SQLite 是事实源；XMind 不作为下一阶段输入" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="326.19" y="2181.4" as="geometry" width="405.44" height="74.6" />
        </mxCell>
        <mxCell id="READY" value="12 筛选 ready 且 applicable&#10;其余点保留在 SQLite / Excel 附表&#10;最终 XMind 仅保留用例对应点" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="388.41" y="2296.0" as="geometry" width="281" height="74.6" />
        </mxCell>
        <mxCell id="INDEX2" value="13 再次准备检索上下文&#10;符合条件时复用，仍核验空间 / manifest / 文件" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfeff;strokeColor=#0891b2;" vertex="1" parent="1">
          <mxGeometry x="322.62" y="2410.6" as="geometry" width="412.58" height="74.6" />
        </mxCell>
        <mxCell id="GENERATE" value="14 第二轮 RAG + Skill · models.llm&#10;就绪点批次检索 → 可选 models.rerank&#10;点 + 规则证据 + 补充资料 + Skill → 用例" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#f5f3ff;strokeColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="344.3" y="2525.2" as="geometry" width="369.22" height="92.2" />
        </mxCell>
        <mxCell id="CONTRACT" value="15 输出契约与本地校验&#10;批次 point_ids 枚举 → 有界修复&#10;规则 / 证据引用、独立边界、步骤和预期风险" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="331.75" y="2657.4" as="geometry" width="394.31" height="92.2" />
        </mxCell>
        <mxCell id="SAVE" value="16 保存 TestCase / Step / CoverageLink / Issue&#10;运行状态、检索审计、ModelInvocation、阶段耗&#10;时" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="315.64" y="2789.6" as="geometry" width="426.52" height="92.2" />
        </mxCell>
        <mxCell id="XM" value="17a XMind · 已生成用例对应的点目录&#10;保留对应测试点及其分组&#10;不含用例步骤，不作为生成输入" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="38" y="2921.8" as="geometry" width="310.41" height="92.2" />
        </mxCell>
        <mxCell id="XL" value="17b Excel · 实际生成的用例&#10;生成内容及附表由导出器排版&#10;无就绪点时可能只有表头" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="388.41" y="2921.8" as="geometry" width="281" height="92.2" />
        </mxCell>
        <mxCell id="REPORT" value="17c 质量 / 覆盖 / manifest&#10;JSON、Markdown 等按格式配置&#10;有 Issue 时可能 partial_failed" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="709.41" y="2921.8" as="geometry" width="314.33" height="92.2" />
        </mxCell>
        <mxCell id="END" value="同一运行目录交付 · 无中间人工审批&#10;自动校验通过仍需用户核对业务语义" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="365.39" y="3054.0" as="geometry" width="329" height="74.6" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
