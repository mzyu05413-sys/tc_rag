        <mxCell id="JOBS" value="提炼 / 规划 / 生成批次队列" style="whiteSpace=wrap;fontColor=#0F172A;fontSize=16;strokeWidth=2;spacing=12;rounded=1;arcSize=10;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
