        <mxCell id="title" value="tc-rag 全流程" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="500" height="34" as="geometry" /></mxCell><mxCell id="sub" value="需求文档 → 解析/提炼 → 检索/规划 → 生成/校验 → 导出；两轮 RAG + Skill 连续执行" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="900" height="22" as="geometry" /></mxCell><mxCell id="bA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="320" height="780" as="geometry" /></mxCell><mxCell id="bA_t" value="1  入口与配置" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="44" y="103" width="296" height="26" as="geometry" /></mxCell><mxCell id="bB" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="95" width="340" height="480" as="geometry" /></mxCell><mxCell id="bB_t" value="2  解析与提炼" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="394" y="103" width="316" height="26" as="geometry" /></mxCell><mxCell id="bC" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="750" y="95" width="340" height="480" as="geometry" /></mxCell><mxCell id="bC_t" value="3  检索与规划" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="764" y="103" width="316" height="26" as="geometry" /></mxCell><mxCell id="bD" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="340" height="480" as="geometry" /></mxCell><mxCell id="bD_t" value="4  生成与校验" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1134" y="103" width="316" height="26" as="geometry" /></mxCell><mxCell id="bE" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1490" y="95" width="220" height="480" as="geometry" /></mxCell><mxCell id="bE_t" value="5  结果" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1504" y="103" width="196" height="26" as="geometry" /></mxCell><mxCell id="bSw" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="590" height="255" as="geometry" /></mxCell><mxCell id="bSw_t" value="开关与策略" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1134" y="608" width="566" height="26" as="geometry" /></mxCell><mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;rag / run / start / doctor / cases / status / inspect / export / evaluate / estimate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#E8EFFF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="270" height="70" as="geometry" /></mxCell><mxCell id="cfg" value="&lt;b&gt;加载配置&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;默认 → YAML → 环境变量 → CLI；Pydantic 校验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="55" y="225" width="270" height="64" as="geometry" /></mxCell><mxCell id="prev" value="&lt;b&gt;仅预览？&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="305" width="270" height="42" as="geometry" /></mxCell><mxCell id="prev_yes" value="&lt;b&gt;打印阶段计划后退出&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;不解析、不调模型&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="55" y="362" width="270" height="48" as="geometry" /></mxCell><mxCell id="build" value="&lt;b&gt;装配 build_pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;统一加载六份 v1 提示词；构造模型与索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="55" y="425" width="270" height="64" as="geometry" /></mxCell><mxCell id="res" value="&lt;b&gt;--resume？&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="505" width="270" height="42" as="geometry" /></mxCell><mxCell id="res_yes" value="&lt;b&gt;校验并复用快照&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;缺失时重解析，页/图缓存命中&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="55" y="562" width="270" height="56" as="geometry" /></mxCell><mxCell id="res_no" value="&lt;b&gt;新建 Run（running）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="55" y="632" width="270" height="48" as="geometry" /></mxCell><mxCell id="noteA" value="&lt;b&gt;配置优先级：CLI &gt; 环境变量 &gt; local.yaml &gt; defaults&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="55" y="700" width="270" height="40" as="geometry" /></mxCell><mxCell id="ingest" value="&lt;b&gt;① ingest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;校验/哈希/复制资产；写 input 快照&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="410" y="135" width="270" height="64" as="geometry" /></mxCell><mxCell id="parse" value="&lt;b&gt;② parse + vision&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;逐页解析+页检查点；完成后并发转写图片&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="410" y="215" width="270" height="64" as="geometry" /></mxCell><mxCell id="chunk" value="&lt;b&gt;③ chunk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;结构分块；保留 block/字符区间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="410" y="295" width="270" height="64" as="geometry" /></mxCell><mxCell id="extract" value="&lt;b&gt;④ extract&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;每 chunk 并发；缓存；Schema 修复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="410" y="375" width="270" height="64" as="geometry" /></mxCell><mxCell id="reconcile" value="&lt;b&gt;reconcile&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;合并相同规则；冲突建 Issue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="410" y="455" width="270" height="64" as="geometry" /></mxCell><mxCell id="index" value="&lt;b&gt;⑤ index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;证据向量化；metric / normalize&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="780" y="135" width="270" height="64" as="geometry" /></mxCell><mxCell id="plan" value="&lt;b&gt;⑥ plan_points&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;检索+融合+重排&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="780" y="215" width="270" height="64" as="geometry" /></mxCell><mxCell id="export_points" value="&lt;b&gt;⑦ 保存测试点&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;保存全部点与 PointTree；最终联合导出 XMind&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="780" y="295" width="270" height="64" as="geometry" /></mxCell><mxCell id="plan_note" value="&lt;b&gt;补充资料可裁剪；直接证据不重排&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="280" height="40" as="geometry" /></mxCell><mxCell id="index2" value="&lt;b&gt;⑧ cases 索引准备&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;按同一需求集绑定索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1150" y="135" width="270" height="64" as="geometry" /></mxCell><mxCell id="generate" value="&lt;b&gt;⑨ generate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;测试点批次；证据+检索 + Skill&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1150" y="215" width="270" height="64" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;⑩ validate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;结构→引用→可执行→依据→重复→覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1150" y="295" width="270" height="64" as="geometry" /></mxCell><mxCell id="export_cases" value="&lt;b&gt;⑪ export_cases&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;XMind + Excel 主表与 6 张附表 + 报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1150" y="375" width="270" height="64" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;运行结果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1510" y="135" width="180" height="40" as="geometry" /></mxCell><mxCell id="ok" value="&lt;b&gt;succeeded&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="1510" y="190" width="180" height="42" as="geometry" /></mxCell><mxCell id="partial" value="&lt;b&gt;partial_failed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;有产物但有待确认项&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFF4E0;strokeColor=#9A5B00;" vertex="1" parent="1"><mxGeometry x="1510" y="245" width="180" height="52" as="geometry" /></mxCell><mxCell id="failed" value="&lt;b&gt;failed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;可 --resume&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FDECEB;strokeColor=#B3261E;" vertex="1" parent="1"><mxGeometry x="1510" y="312" width="180" height="42" as="geometry" /></mxCell><mxCell id="cancelled" value="&lt;b&gt;cancelled&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5B6472'&gt;Ctrl+C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FDECEB;strokeColor=#B3261E;" vertex="1" parent="1"><mxGeometry x="1510" y="368" width="180" height="42" as="geometry" /></mxCell><mxCell id="sw" value="&lt;b&gt;常用开关&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1140" y="640" width="550" height="190" as="geometry" /></mxCell><mxCell id="swtxt" value="--metric cosine|euclidean|dot&lt;br&gt;--normalize / --no-normalize&lt;br&gt;--preview / --quiet / --skill-file&lt;br&gt;runtime.chunk_failure_policy = fail | skip&lt;br&gt;models.rerank.enabled / parsing.vision_enabled" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1155" y="672" width="520" height="140" as="geometry" /></mxCell>
