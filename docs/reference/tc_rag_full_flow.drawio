<mxfile host="app.diagrams.net" modified="2026-10-28T00:00:00.000Z" agent="tc-rag" version="24.7.17">
  <diagram id="tc-rag-full-flow" name="tc-rag 全流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;rag（交互）· run / start · doctor / cases / status / inspect / export / evaluate / estimate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#E8EFFF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="320" height="72" as="geometry" /></mxCell><mxCell id="cfg" value="&lt;b&gt;加载配置&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;默认值 → YAML → 环境变量 → CLI；Pydantic 校验；密钥只从环境或 SecretStr 读取&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="320" height="66" as="geometry" /></mxCell><mxCell id="preview" value="&lt;b&gt;仅预览？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="260" width="320" height="50" as="geometry" /></mxCell><mxCell id="build" value="&lt;b&gt;装配 build_pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;统一加载六份 v1 提示词；构造模型/索引/导出器&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="350" width="320" height="66" as="geometry" /></mxCell><mxCell id="resume" value="&lt;b&gt;--resume？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="320" height="50" as="geometry" /></mxCell><mxCell id="ingest" value="&lt;b&gt;① ingest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;校验/哈希/复制资产；写 input 快照&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="320" height="66" as="geometry" /></mxCell><mxCell id="parse" value="&lt;b&gt;② parse + vision&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;逐页解析+页检查点；全部页完成后并发转写图片&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="630" width="320" height="66" as="geometry" /></mxCell><mxCell id="chunk" value="&lt;b&gt;③ chunk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;结构分块；保留 (block_id, start, end) 来源映射&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="720" width="320" height="66" as="geometry" /></mxCell><mxCell id="extract" value="&lt;b&gt;④ extract&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;每 chunk 并发；缓存；Schema 修复；单块失败按策略 skip/fail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="810" width="320" height="66" as="geometry" /></mxCell><mxCell id="reconcile" value="&lt;b&gt;reconcile&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;相同规则合并证据；条件不同保留；冲突建 Issue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="900" width="320" height="66" as="geometry" /></mxCell><mxCell id="index" value="&lt;b&gt;⑤ index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;需求证据向量化；按 metric / normalize 建索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1080" width="320" height="66" as="geometry" /></mxCell><mxCell id="plan" value="&lt;b&gt;⑥ plan_points&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;规则批次；检索+融合+重排；预算裁剪&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1170" width="320" height="66" as="geometry" /></mxCell><mxCell id="export_points" value="&lt;b&gt;⑦ 保存测试点&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;SQLite 保存全部点与 PointTree；最终联合导出 XMind&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1260" width="320" height="66" as="geometry" /></mxCell><mxCell id="index2" value="&lt;b&gt;⑧ cases 索引准备&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;按同一需求集绑定检索索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1360" width="320" height="66" as="geometry" /></mxCell><mxCell id="generate" value="&lt;b&gt;⑨ generate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;测试点批次；直接证据+检索 + Skill；Schema 修复/二分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1450" width="320" height="66" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;⑩ validate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;结构→引用→可执行→依据→重复→覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1540" width="320" height="66" as="geometry" /></mxCell><mxCell id="export_cases" value="&lt;b&gt;⑪ export_cases&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;XMind + Excel（主表+6 张可读附表）+ 报告 + manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="430" y="1630" width="320" height="66" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;运行结果&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="1720" width="320" height="50" as="geometry" /></mxCell><mxCell id="preview_yes" value="&lt;b&gt;打印阶段计划后退出&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;不解析、不调模型&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="280" height="56" as="geometry" /></mxCell><mxCell id="resume_yes" value="&lt;b&gt;校验并复用快照&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;chunk 缺失时重解析，页/图缓存命中&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="280" height="60" as="geometry" /></mxCell><mxCell id="resume_no" value="&lt;b&gt;新建 Run（running）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="810" y="440" width="280" height="56" as="geometry" /></mxCell><mxCell id="extract_note" value="&lt;b&gt;修复与跳过&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;Schema 失败→有限修复；仍失败→skip 记 Issue / fail 中止&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFF4E0;strokeColor=#9A5B00;" vertex="1" parent="1"><mxGeometry x="810" y="810" width="280" height="66" as="geometry" /></mxCell><mxCell id="ok_done" value="&lt;b&gt;succeeded&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#E7F7EF;strokeColor=#0F7B4F;" vertex="1" parent="1"><mxGeometry x="80" y="1720" width="260" height="46" as="geometry" /></mxCell><mxCell id="partial" value="&lt;b&gt;partial_failed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;有效产物已导出，但存在待确认问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFF4E0;strokeColor=#9A5B00;" vertex="1" parent="1"><mxGeometry x="80" y="1780" width="260" height="52" as="geometry" /></mxCell><mxCell id="failed" value="&lt;b&gt;failed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;记录阶段；可 --resume&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FDECEB;strokeColor=#B3261E;" vertex="1" parent="1"><mxGeometry x="810" y="1720" width="260" height="46" as="geometry" /></mxCell><mxCell id="cancelled" value="&lt;b&gt;cancelled&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;Ctrl+C；保存已完成结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FDECEB;strokeColor=#B3261E;" vertex="1" parent="1"><mxGeometry x="810" y="1780" width="260" height="46" as="geometry" /></mxCell><mxCell id="switches" value="&lt;b&gt;常用开关&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5B6472'&gt;--metric cosine|euclidean|dot · --normalize/--no-normalize · --preview · --resume/--from-stage · --skill-file · --quiet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="e_cli_cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="cli" target="cfg" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_cfg_preview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="cfg" target="preview" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_preview_build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="preview" target="build" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_build_resume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="build" target="resume" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_resume_ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="resume" target="ingest" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ingest_parse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="ingest" target="parse" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_parse_chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="parse" target="chunk" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_chunk_extract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="chunk" target="extract" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_extract_reconcile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="extract" target="reconcile" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_index_plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="index" target="plan" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_plan_export_points" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="plan" target="export_points" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_export_points_index2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="export_points" target="index2" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_index2_generate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="index2" target="generate" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_generate_validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="generate" target="validate" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_validate_export_cases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="validate" target="export_cases" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_export_cases_result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="export_cases" target="result" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_preview_preview_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="preview" target="preview_yes"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_resume_resume_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="resume" target="resume_yes"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_resume_resume_no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="resume" target="resume_no"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_extract_extract_note" value="异常" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;dashed=1;" edge="1" parent="1" source="extract" target="extract_note"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_result_ok_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="result" target="ok_done" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_result_partial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="result" target="partial" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_result_failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="result" target="failed" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_result_cancelled" style="edgeStyle=orthogonalEdgeStyle;roun