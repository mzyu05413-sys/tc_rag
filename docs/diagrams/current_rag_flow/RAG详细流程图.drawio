<mxfile host="app.diagrams.net"><diagram name="当前详细流程" id="current"><mxGraphModel page="1" pageWidth="1680" pageHeight="3040"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="input" value="&lt;b&gt;输入需求文档&lt;/b&gt;&lt;br&gt;PDF / DOCX ＋ 本次生成要求" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="650" y="265" width="380" height="75" as="geometry" /></mxCell><mxCell id="parse" value="&lt;b&gt;读取文档内容&lt;/b&gt;&lt;br&gt;读取段落、表格和图片&lt;br&gt;保留标题与原文位置" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="650" y="360" width="380" height="105" as="geometry" /></mxCell><mxCell id="text" value="&lt;b&gt;保留正文与表格&lt;/b&gt;&lt;br&gt;正文保留原句&lt;br&gt;表格保留行列关系和原文位置" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="180" y="485" width="480" height="115" as="geometry" /></mxCell><mxCell id="image" value="&lt;b&gt;提取图片&lt;/b&gt;&lt;br&gt;保存图片文件和所在位置" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#a36b14;fontColor=#25374a;"><mxGeometry x="1020" y="485" width="480" height="95" as="geometry" /></mxCell><mxCell id="cache" value="&lt;b&gt;检查图片与已有结果&lt;/b&gt;&lt;br&gt;检查图片是否可用&lt;br&gt;已有识别结果可直接复用" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#a36b14;fontColor=#25374a;"><mxGeometry x="1020" y="615" width="480" height="105" as="geometry" /></mxCell><mxCell id="vision" value="&lt;b&gt;图片转文字与复核&lt;/b&gt;&lt;br&gt;按配置缩放或分图后识别&lt;br&gt;说明图片内容，可再复核并记录疑问" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#fffaf0;strokeColor=#a36b14;fontColor=#25374a;"><mxGeometry x="1020" y="755" width="480" height="110" as="geometry" /></mxCell><mxCell id="combine" value="&lt;b&gt;汇总可用文字&lt;/b&gt;&lt;br&gt;原文与图片说明分开标记，保留来源" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="600" y="900" width="480" height="80" as="geometry" /></mxCell><mxCell id="chunk" value="&lt;b&gt;把文字拆成小段&lt;/b&gt;&lt;br&gt;按段落、表格和标题拆分&lt;br&gt;每段保留对应的原文位置" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="100" y="1160" width="400" height="115" as="geometry" /></mxCell><mxCell id="extract" value="&lt;b&gt;逐段提取需求&lt;/b&gt;&lt;br&gt;模型提取功能、业务规则&lt;br&gt;同时给出对应的原文依据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="640" y="1160" width="400" height="115" as="geometry" /></mxCell><mxCell id="check" value="&lt;b&gt;核对并整理结果&lt;/b&gt;&lt;br&gt;检查引文及对象关联&lt;br&gt;归并重复，记录冲突和缺失" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="1180" y="1160" width="400" height="115" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;功能与需求规则&lt;/b&gt;&lt;br&gt;保存功能、规则和原文依据&lt;br&gt;供后续规划与生成使用&lt;br&gt;不会直接把规则当成完整测试用例" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="120" y="1390" width="590" height="145" as="geometry" /></mxCell><mxCell id="index" value="&lt;b&gt;准备需求证据索引&lt;/b&gt;&lt;br&gt;原文依据及来源文字转成向量&lt;br&gt;可选：增加关键词检索&lt;br&gt;两轮RAG使用同一份需求范围" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#edf5ff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="970" y="1390" width="590" height="145" as="geometry" /></mxCell><mxCell id="query_one" value="&lt;b&gt;准备规划输入&lt;/b&gt;&lt;br&gt;生成要求与一批规则&lt;br&gt;程序先生成基础测试点&lt;br&gt;原文依据直接保留" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="80" y="1870" width="300" height="165" as="geometry" /></mxCell><mxCell id="search_one" value="&lt;b&gt;查找相关需求&lt;/b&gt;&lt;br&gt;查询文字转成向量&lt;br&gt;向量与可选关键词检索&lt;br&gt;可选：重新排序" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="480" y="1870" width="300" height="165" as="geometry" /></mxCell><mxCell id="context_one" value="&lt;b&gt;整理本轮依据&lt;/b&gt;&lt;br&gt;已有原文优先保留&lt;br&gt;补充相关条件与例外&lt;br&gt;超出预算先减少补充" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="880" y="1870" width="300" height="165" as="geometry" /></mxCell><mxCell id="generate_one" value="&lt;b&gt;生成测试点&lt;/b&gt;&lt;br&gt;保留已有基础测试点&lt;br&gt;模型补充测试目标&lt;br&gt;每点关联需求规则" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="1280" y="1870" width="300" height="165" as="geometry" /></mxCell><mxCell id="query_two" value="&lt;b&gt;准备用例输入&lt;/b&gt;&lt;br&gt;选出可生成的测试点&lt;br&gt;补齐所属功能的规则&lt;br&gt;保留原文依据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#11806b;fontColor=#25374a;"><mxGeometry x="80" y="2460" width="300" height="165" as="geometry" /></mxCell><mxCell id="search_two" value="&lt;b&gt;查找相关需求&lt;/b&gt;&lt;br&gt;查询文字转成向量&lt;br&gt;向量与可选关键词检索&lt;br&gt;可选：重新排序" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#11806b;fontColor=#25374a;"><mxGeometry x="480" y="2460" width="300" height="165" as="geometry" /></mxCell><mxCell id="context_two" value="&lt;b&gt;整理本轮依据&lt;/b&gt;&lt;br&gt;已有原文优先保留&lt;br&gt;补充相关条件与例外&lt;br&gt;超出预算先减少补充" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#11806b;fontColor=#25374a;"><mxGeometry x="880" y="2460" width="300" height="165" as="geometry" /></mxCell><mxCell id="generate_two" value="&lt;b&gt;生成并检查用例&lt;/b&gt;&lt;br&gt;模型生成步骤和预期&lt;br&gt;检查格式、引用和覆盖&lt;br&gt;保留问题与失败记录" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#11806b;fontColor=#25374a;"><mxGeometry x="1280" y="2460" width="300" height="165" as="geometry" /></mxCell><mxCell id="points" value="&lt;b&gt;保存测试点&lt;/b&gt;&lt;br&gt;保存所属功能、需求规则与原文引用&lt;br&gt;待澄清的测试点继续保留，不强行生成用例" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#ffffff;strokeColor=#2463b3;fontColor=#25374a;"><mxGeometry x="570" y="2120" width="540" height="100" as="geometry" /></mxCell><mxCell id="output" value="&lt;b&gt;输出交付文件&lt;/b&gt;&lt;br&gt;测试点 XMind ＋ 测试用例 Excel&lt;br&gt;同时输出质量报告和待确认问题" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fillColor=#effaf6;strokeColor=#11806b;fontColor=#25374a;"><mxGeometry x="570" y="2690" width="540" height="110" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="input" target="parse" value="" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#728398;dashed=0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" source="parse" target="text" va