          <mxGeometry x="1020" y="1530" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="context1" value="&lt;div&gt;&lt;b&gt;组装第一轮上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;规则直接证据不经检索裁剪；检索资料仅作补充&lt;br&gt;完整请求超预算时先裁低优先级补充资料&lt;br&gt;补充内容不能自动新增规则、扩大引用范围&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="90" y="1775" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="context2" value="&lt;div&gt;&lt;b&gt;组装第二轮上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;直接加载点关联规则、所属功能相关证据及 Skill&lt;br&gt;每步允许引用范围仍受所选点的规则 / 证据约束&lt;br&gt;补充证据按预算裁减，不替代直接依据&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="1020" y="1775" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;div&gt;&lt;b&gt;LLM 补充测试意图 → PointBatch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;models.llm ＋ prompts/plan_points/v2.md&lt;br&gt;补正常、异常、权限、状态等意图；不重复程序已计算边界&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="90" y="1905" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="point_tree" value="&lt;div&gt;&lt;b&gt;校验、归并并保存 PointTree&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;批次规则引用、重复与来源风险检查，保留各状态&lt;br&gt;不要求人工批准，不把 XMind 回读成生成输入&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="90" y="2020" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="selected_points" value="&lt;div&gt;&lt;b&gt;筛选就绪点，准备 / 复用检索索引&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;当前运行满足版本与空间条件时复用索引&lt;br&gt;不会因为第二轮就必然重新向量化全部文档&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="1020" y="1425" width="650" height="75" as="geometry" />
        </mxCell>
        <mxCell id="generate" value="&lt;div&gt;&lt;b&gt;LLM ＋ Skill 生成 CaseBatch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;models.llm ＋ generate/v2.md ＋ case_skill/v2.md&lt;br&gt;仅为本批测试点生成：前置、数据、动作、可观察预期&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="1020" y="1905" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="case_check" value="&lt;div&gt;&lt;b&gt;用例校验与有限覆盖补生成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;Schema / 批次 ID / 引用闭包 / 依据风险 / 重复 / 覆盖&lt;br&gt;可修复缺口受次数和调用预算限制；仍需检索与模型调用&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="1020" y="2020" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cases_save" value="&lt;div&gt;&lt;b&gt;保存实际用例、覆盖与问题&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;SQLite 保持事实记录，校验通过不证明业务语义正确&lt;br&gt;没有通过校验的内容不伪造成有效用例&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="1020" y="2135" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="retrieval1" value="&lt;div&gt;&lt;b&gt;检索 → 可选重排&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;models.embedding：查询向量化＋缓存；当前需求索引向量 Top K&lt;br&gt;可选关键词检索＋RRF；可选 models.rerank 重排前 N 个&lt;br&gt;重排结果接回其余候选；失败保留召回排名，不是只保留 N 项&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="90" y="1645" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="retrieval2" value="&lt;div&gt;&lt;b&gt;检索 → 可选重排&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;models.embedding：查询向量化＋缓存；当前需求索引向量 Top K&lt;br&gt;可选关键词检索＋RRF；可选 models.rerank 重排前 N 个&lt;br&gt;重排结果接回其余候选；失败保留召回排名，不是只保留 N 项&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
