        <mxCell id="excel" value="&lt;div&gt;&lt;b&gt;Excel · 实际生成用例&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#9b9b9b&quot;&gt;标题、前置、数据、步骤与预期；列与格式由导出器负责&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
