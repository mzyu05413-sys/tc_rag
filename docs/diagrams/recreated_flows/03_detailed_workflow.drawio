        <mxCell id="base_points" value="&lt;div&gt;&lt;b&gt;本地基础测试点&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#9b9b9b&quot;&gt;按有效规则计算可确定的边界等基础意图&lt;br&gt;不凭空补精度、角色、数字；缺失信息进入 Issue&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=1;shadow=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#e8e8e8;align=center;verticalAlign=middle;fillColor=#292929;strokeColor=#c3c3c3;strokeWidth=1;" vertex="1" parent="nodes">
          <mxGeometry x="90" y="1425" width="650" height="75" as="geometry" />
